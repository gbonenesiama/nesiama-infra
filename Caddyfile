# ── Knowledge project ─────────────────────────────────────────────────────────
# knowledge_caddy handles all internal routing for talktotps.com (frontend/API).
# We move it from 0.0.0.0:80 to 127.0.0.1:8088 and proxy here.
# One change in /opt/knowledge/docker-compose.yml:
#   ports: ["127.0.0.1:8088:80"]   ← was "0.0.0.0:80:80"

talktotps.com, www.talktotps.com {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options    "nosniff"
        Referrer-Policy           "strict-origin-when-cross-origin"
        -Server
    }
    reverse_proxy host.docker.internal:8088
}

# ── Battlestocks ──────────────────────────────────────────────────────────────
# Redeploy with deploy/docker-compose.prod.yml to move from
# 0.0.0.0:8080 → 127.0.0.1:8081 (loopback only).
# WebSocket (STOMP) proxied natively by Caddy.

battlestocks.nesiama.com {
    tls internal
    encode zstd gzip
    header {
        -Server
    }
    reverse_proxy host.docker.internal:8081
}

