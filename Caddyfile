# ── Pantry Agent ──────────────────────────────────────────────────────────────
# Already on 127.0.0.1:8091. No changes needed there.

pantry.nesiama.com {
    tls internal
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Frame-Options           "DENY"
        X-Content-Type-Options    "nosniff"
        Referrer-Policy           "strict-origin-when-cross-origin"
        -Server
    }

    rate_limit {
        zone webhook_per_ip {
            match {
                path /webhook/*
            }
            key    {remote_host}
            events 60
            window 1m
        }
        zone setup_link_per_ip {
            match {
                path /api/profile/setup-link
            }
            key    {remote_host}
            events 5
            window 1m
        }
    }

    reverse_proxy host.docker.internal:8091
}

